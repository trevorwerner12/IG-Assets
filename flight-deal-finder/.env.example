# ---------------------------------------------------------------
# Flight Deal Finder settings
# Copy this file to ".env" (same folder) and fill in your key.
# ---------------------------------------------------------------

# Your SerpApi key from https://serpapi.com/manage-api-key
# Leave blank to run in DEMO mode with fake sample flights.
SERPAPI_KEY=

# How long (hours) to reuse a saved search result before spending
# another API credit on the same search.
CACHE_HOURS=6

# Ask for confirmation before a search that would use more than
# this many credits (flexible dates use 1 credit per date).
CONFIRM_ABOVE_CREDITS=3

# Hard cap: never use more than this many credits in one search.
MAX_CREDITS_PER_SEARCH=14

# Do you have the Chase United Explorer card? (first checked bag free on United)
UNITED_EXPLORER_CARD=yes

# Price alerts: how often to re-check saved alerts while the app is open (hours).
ALERT_CHECK_HOURS=12

# Optional: phone/desktop push notifications via the free ntfy app (https://ntfy.sh).
# Pick a long, hard-to-guess topic name, subscribe to it in the ntfy app, and put it here.
NTFY_TOPIC=

# Web page port (open http://localhost:5055)
PORT=5055
