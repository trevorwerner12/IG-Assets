# Copy this file to .env.local, then fill in SUPABASE_SECRET_KEY.
# .env.local is ignored by git, so your keys never get committed.

# Supabase project "baseball-lessons". These two are safe to share:
# they're sent to every visitor's browser anyway.
NEXT_PUBLIC_SUPABASE_URL=https://qdshsjnmuwwprftfukps.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ykLgTJ9B1-Rucew0LpIvJQ_A0h76NSi

# Secret key: server-only. Never share it or put it in browser code.
# Supabase → Project Settings → API Keys → Secret keys → copy the "default" key.
SUPABASE_SECRET_KEY=sb_secret_...

# The address of the site (used in sign-up confirmation emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
