# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=

# Twilio (console.twilio.com -> Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The exact public URL you set as the webhook in Twilio, e.g. https://abc.ngrok.app/sms
PUBLIC_WEBHOOK_URL=
TWILIO_VALIDATE_SIGNATURE=true

# Your own phone number (E.164). Gets a text when a conversation needs you.
OWNER_PHONE=

# Optional
BOT_MODEL=claude-opus-5
BOT_EFFORT=low
BOT_HISTORY_TURNS=20
BOT_DB_PATH=conversations.db
DRY_RUN=false
PORT=8000
